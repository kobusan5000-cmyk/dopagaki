extends RefCounted
# Eight 32x32 frames sampled from the user-provided star+triangle enemy art.
# Store the compact PNG as base64 so it can be versioned as plain text via GitHub.
const PNG_BASE64 := ""

static func build_texture() -> Texture2D:
	var raw: PackedByteArray = Marshalls.base64_to_raw(PNG_BASE64)
	var picture := Image.new()
	var err: Error = picture.load_png_from_buffer(raw)
	if err != OK:
		push_error("STAR DUO sprite decoding failed: %s" % str(err))
		return null
	return ImageTexture.create_from_image(picture)
